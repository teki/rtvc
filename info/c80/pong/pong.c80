// Pong as one C80 USR. BASIC only launches it:
//   10 LET R=USR(@{pong::play},0)
//   20 PRINT R
// play() does not return until someone reaches WIN. PRINT is 1 if you won,
// -1 if the AI won.
//
// Playfield (GRAPHICS 4, VID0 at 8000H after mapper 50H):
//   240 visible rasters (Y in 0..239), 64 bytes per raster.
//   One byte is four 4-colour pixels. Sprites are whole bytes (no
//   pixel masks): left paddle column 2, AI column 61, ball one column.
//   Byte (col, y) is memory[y * 64 + 0x8000 + col].
//   Paddles are 24 rasters tall, ball is 4. Y is the top row (inclusive);
//   the bottom is exclusive, so a paddle occupies [py, py+24).
//
// Drawing never repaints a whole sprite after the first stamp. A move only
// writes the new edge and clears the old one. put_row() and fill_rows() take
// only the raster y (in A); column, pixel value and span length live in
// globals, so a stamp and the matching erase share the same draw_h.
//
// What to look at in the listing: put_row() and read_row() are @inline, so
// they cost what a macro would: fill_rows() has put_row()'s body in its loop
// (`; inline put_row`), with y in C and n in B, and no CALL, RET or save.
// Neither has an out-of-line copy. The private functions play() calls once
// (setup, wait_frame, serve, move_ai, physics, restore) are expanded there
// automatically (`; inline ... (auto)`), so they have no copy either; their
// directives below run against a build that keeps the bodies.
// play() never returns in a test run, so it is skipped.
//
// Keyboard is an 11x8 active-low matrix: out 03H selects the row, in 58H
// reads the columns (0 = pressed). Joystick / cursor keys are row 8
// (bit 1 up, bit 2 down). Space is row 7 bit 5.

pub const u8 WIN = 5;

// 0 = waiting for Space, 1 = in play, 2 = player reached WIN, 3 = AI did.
u8 state;
u8 pscore;
u8 ascore;
u8 py;          // left paddle top, even, steps of 2
u8 ay;          // right paddle top, steps of 1
u8 bx;          // ball column 0..63
u8 by;          // ball top raster
i8 vx;          // 0 = waiting to serve, else ±1
i8 vy;
u8 draw_col;    // VRAM column for put_row
u8 draw_val;    // 0xFF = four white pixels, 0 = clear
u8 draw_h;      // how many rasters fill_rows should write

// OUT (3),A then IN A,(58H): row arrives in A, the columns return in A.
//! expect: read_row(8) == 0x7F with in(0x58) = 0x7F
//! expect-mem: read_row(8) => out(0x03) == 8
@inline u8 read_row(u8 row) {
    cpu::out(0x03, row);
    return cpu::in(0x58);
}

// Store draw_val at (draw_col, y). y * 64 is `<< 6` of the zero-extended y
// in HL (C80 has no `*`). The compiler shifts right by two and moves bytes
// instead of doubling six times:
//
//     XOR A
//     SRL H / RR L / RRA    ; twice: the low bits leave through carry into A
//     LD H,L
//     LD L,A                ; 52 T, 13 bytes
//
// Six `a += a` lines compiled to LD D,H / LD E,L / ADD HL,DE each (114 T,
// 18 bytes); the whole function went from 228 T, 43 bytes to the budgets
// below. They measure the body as a function; expanded in fill_rows() it
// also saves the CALL and RET (27 T per row).
//! expect-tstates: put_row == 151
//! expect-bytes: put_row == 34
//! expect-mem: put_row(3) => [0x80C2] == 0xFF with draw_col = 2, draw_val = 0xFF
//! expect-mem: put_row(239) => [0xBBFD] == 0xFF with draw_col = 61, draw_val = 0xFF
@inline void put_row(u8 y) {
    u16 a;
    ptr<u8> p;
    a = u16(y) << 6;
    p = ptr<u8>(a + 0x8000) + draw_col;
    *p = draw_val;
}

// Write draw_h rasters starting at y. Count down a copy, so a later erase
// can still see the original draw_h.
//! expect-mem: fill_rows(10) => [0x8282] == 0xFF with draw_h = 2, draw_col = 2, draw_val = 0xFF
//! expect-mem: fill_rows(10) => [0x82C2] == 0xFF with draw_h = 2, draw_col = 2, draw_val = 0xFF
//! expect-mem: fill_rows(10) => [0x8302] == 0 with draw_h = 2, draw_col = 2, draw_val = 0xFF
//! expect-mem: fill_rows(10) => draw_h == 2 with draw_h = 2, draw_col = 2, draw_val = 0xFF
void fill_rows(u8 y) {
    u8 n;
    n = draw_h;
    while (n != 0) {
        put_row(y);
        y = y + 1;
        n = n - 1;
    }
}

//! expect-mem: wait_frame() => out(0x07) == 0, 0 with in(0x59) = 0x10 0x00
void wait_frame() {
    // Bit 4 of 59H is the shared cursor/sound IRQ, active low. DI during
    // setup's LDIR leaves it pending, so ACK first or the idle wait never ends.
    cpu::out(0x07, 0);
    while ((cpu::in(0x59) & 0x10) != 0) {
    }
    cpu::out(0x07, 0);
}

// Center the ball and freeze it. Space in serve() sets vx/vy.
//! expect-mem: place_ball() => bx == 32
//! expect-mem: place_ball() => by == 118
void place_ball() {
    bx = 32;
    by = 118;
    vx = 0;
    vy = 0;
    state = 0;
}

// Paddle [pad_y, pad_y+24) overlaps ball [by, by+4). pad_y arrives in A;
// by is read from its global.
//! expect: hits(100) == true with by = 110
//! expect: hits(100) == false with by = 124
//! expect: hits(100) == false with by = 96
//! expect: hits(100) == true with by = 97
bool hits(u8 pad_y) {
    if (by < pad_y + 24 && pad_y < by + 4) {
        return true;
    }
    return false;
}

//! expect-mem: scored(true) => state == 2 with pscore = 4
//! expect-mem: scored(false) => ascore == 1
//! expect-mem: scored(false) => bx == 32 with bx = 5
void scored(bool player) {
    if (player) {
        pscore = pscore + 1;
        if (pscore == WIN) {
            state = 2;
            return;
        }
    } else {
        ascore = ascore + 1;
        if (ascore == WIN) {
            state = 3;
            return;
        }
    }
    place_ball();
}

// Joystick up (bit 1 low) moves the paddle up two rasters.
//! expect-mem: move_player() => py == 8 with py = 10, in(0x58) = 0xFD
//! expect-mem: move_player() => py == 12 with py = 10, in(0x58) = 0xFB
void move_player() {
    u8 joy;
    joy = read_row(8);
    // Up: new top is two white rows at py; old bottom was [py+24, py+26).
    if ((joy & 0x02) == 0) {
        if (py >= 2) {
            py = py - 2;
            draw_col = 2;
            draw_h = 2;
            draw_val = 0xFF;
            fill_rows(py);
            draw_val = 0;
            fill_rows(py + 24);
        }
    }
    // Down: erase the old top at py-2, stamp two new rows at py+22
    // (the paddle now ends at py+24).
    if ((joy & 0x04) == 0) {
        if (py < 214) {
            py = py + 2;
            draw_col = 2;
            draw_h = 2;
            draw_val = 0;
            fill_rows(py - 2);
            draw_val = 0xFF;
            fill_rows(py + 22);
        }
    }
}

// Space (row 7, bit 5 low) serves.
//! expect-mem: serve() => state == 1 with in(0x58) = 0xDF
//! expect-mem: serve() => state == 0 with in(0x58) = 0xFF
void serve() {
    u8 keys;
    keys = read_row(7);
    if (vx == 0 && (keys & 0x20) == 0) {
        vx = 1;
        vy = 1;
        state = 1;
    }
}

// One raster per frame, and only while the ball is moving, so the player
// (step 2) can outrun it. Compare centres: ball is 4 tall, paddle 24.
//! expect-mem: move_ai() => ay == 51 with vx = 1, by = 118, ay = 50
//! expect-mem: move_ai() => ay == 50 with vx = 0, by = 118, ay = 50
void move_ai() {
    u8 ball;
    u8 pad;
    if (vx == 0) {
        return;
    }
    ball = by + 2;
    pad = ay + 12;
    if (ball < pad) {
        if (ay != 0) {
            ay = ay - 1;
            draw_col = 61;
            draw_h = 1;
            draw_val = 0xFF;
            fill_rows(ay);
            draw_val = 0;
            fill_rows(ay + 24);
        }
    } else {
        if (ball > pad) {
            if (ay < 216) {
                ay = ay + 1;
                draw_col = 61;
                draw_h = 1;
                draw_val = 0;
                fill_rows(ay - 1);
                draw_val = 0xFF;
                fill_rows(ay + 23);
            }
        }
    }
}

// After physics(), (ox, oy) is where the ball was. Same column: slide
// vertically (paint the uncovered edge, clear the vacated one). Column
// changed: erase the old 4-row stamp and draw a new one — even if Y moved
// too. A paddle bounce keeps X still, so it takes the Y-only path.
// Moving down from raster 19 to 20 in column 10 clears row 19 and paints 23.
//! expect-mem: ball_sync(10, 19) => [0x84CA] == 0 with bx = 10, by = 20, [0x84CA] = 0xFF
//! expect-mem: ball_sync(10, 19) => [0x85CA] == 0xFF with bx = 10, by = 20
void ball_sync(u8 ox, u8 oy) {
    if (bx == ox) {
        if (by == oy) {
            return;
        }
        draw_col = bx;
        if (by < oy) {
            draw_h = oy - by;
            draw_val = 0xFF;
            fill_rows(by);
            draw_val = 0;
            fill_rows(by + 4);
        } else {
            draw_h = by - oy;
            draw_val = 0;
            fill_rows(oy);
            draw_val = 0xFF;
            fill_rows(oy + 4);
        }
        return;
    }
    draw_h = 4;
    draw_col = ox;
    draw_val = 0;
    fill_rows(oy);
    draw_col = bx;
    draw_val = 0xFF;
    fill_rows(by);
}

//! expect-mem: physics() => bx == 11 with vx = 1, vy = 1, bx = 10, by = 20
//! expect-mem: physics() => by == 21 with vx = 1, vy = 1, bx = 10, by = 20
//! expect-mem: physics() => vy == 1 with vx = 1, vy = -1, bx = 10, by = 0
void physics() {
    u8 ox;
    u8 oy;
    if (vx == 0) {
        return;
    }
    ox = bx;
    oy = by;
    // Ball is 4 rasters; 236+4 = 240, the first row past the paper.
    if (vy < 0) {
        if (by == 0) {
            vy = 1;
        } else {
            by = by - 1;
        }
    } else {
        if (by >= 236) {
            vy = -1;
        } else {
            by = by + 1;
        }
    }
    // Flip vx on the paddle columns without moving X, so ball_sync can
    // keep the same column. Miss and walk off 0 or 63 to score.
    if (vx < 0) {
        if (bx <= 3 && hits(py)) {
            vx = 1;
        } else {
            if (bx == 0) {
                scored(false);
            } else {
                bx = bx - 1;
            }
        }
    } else {
        if (bx >= 60 && hits(ay)) {
            vx = -1;
        } else {
            if (bx >= 63) {
                scored(true);
            } else {
                bx = bx + 1;
            }
        }
    }
    ball_sync(ox, oy);
}

//! expect-mem: setup() => out(0x02) == 0x50
//! expect-mem: setup() => [0x0B13] == 0x11 with [0x0B13] = 0x12
//! expect-mem: setup() => [0xBBFF] == 0 with [0xBBFF] = 0x55
void setup() {
    ptr<u8> pal;
    ptr<u8> vram;
    // ROM ISR would stamp a cursor into VID0. Stay DI until restore().
    cpu::di();
    // Palette 0..3 and a dark border. 0x0B13 is the firmware copy of port
    // 06H; force bits 0-1 to 01 (GRAPHICS 4) and write it back.
    cpu::out(0x60, 0);
    cpu::out(0x61, 0x14);
    cpu::out(0x62, 0x44);
    cpu::out(0x63, 0x55);
    cpu::out(0x00, 0x20);
    pal = ptr<u8>(0x0B13);
    *pal = (*pal & 0xFC) | 0x01;
    cpu::out(0x06, *pal);
    // 50H: VID0 in the 8000H window. 70H (restore) puts U2 back there.
    cpu::out(0x02, 0x50);
    // R10/R11: cursor shape. R14-R15 = 0x0EFF, last paper byte, so the
    // cursor IRQ (and wait_frame) lands on raster 239. VT-DOS leaves
    // 0x0AFF (raster 175) and would sync mid-screen.
    cpu::out(0x70, 0x0A);
    cpu::out(0x71, 0x03);
    cpu::out(0x70, 0x0B);
    cpu::out(0x71, 0x03);
    cpu::out(0x70, 0x0E);
    cpu::out(0x71, 0x0E);
    cpu::out(0x70, 0x0F);
    cpu::out(0x71, 0xFF);
    // 240 * 64 = 0x3C00 paper bytes. Zero the first, LDIR the rest
    // (HL is source, DE is dest — Z80 order, not memcpy).
    vram = ptr<u8>(0x8000);
    *vram = 0;
    cpu::ldir(vram, ptr<u8>(0x8001), 0x3BFF);
}

//! expect-mem: restore() => out(0x02) == 0x70
void restore() {
    cpu::out(0x02, 0x70);
    cpu::ei();
}

// USR argument arrives in HL and is ignored. Return 1 or -1 in HL.
// @fastcall: the loop fits in registers (no spill, save or IX).
//! expect-skip: play - loops until someone reaches WIN; needs keyboard input over many frames
@fastcall pub i16 play(i16 unused) {
    setup();
    pscore = 0;
    ascore = 0;
    py = 108;
    ay = 108;
    place_ball();
    draw_val = 0xFF;
    draw_h = 24;
    draw_col = 2;
    fill_rows(py);
    draw_col = 61;
    fill_rows(ay);
    draw_h = 4;
    draw_col = bx;
    fill_rows(by);
    while (state < 2) {
        wait_frame();
        move_player();
        serve();
        move_ai();
        physics();
    }
    restore();
    if (state == 2) {
        return 1;
    }
    return -1;
}
