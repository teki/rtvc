// Pong as one C80 game loop. BASIC only launches it, through the ASM entry
// in irq.asm, which hooks the frame interrupt and calls play():
//   10 LET R=USR(@{irq::start},0)
//   20 PRINT R
// play() does not return until someone reaches WIN. PRINT is 1 if you won,
// -1 if the AI won.
//
// Playfield (GRAPHICS 4, VID0 at 8000H after mapper 50H):
//   240 visible rasters (Y in 0..239), 64 bytes per raster.
//   One byte is four 4-colour pixels. Sprites are whole bytes (no
//   pixel masks): left paddle column 2, AI column 61, ball one column.
//   Byte (col, y) is memory[y * 64 + 0x8000 + col].
//   Paddles are 24 rasters tall, ball is 4. Y is the top row (inclusive);
//   the bottom is exclusive, so a paddle occupies [py, py+24).
//   The ball stays in columns 3..60: it bounces or scores on the column
//   next to a paddle, so it never overlaps one. Columns 0 and 63 hold the
//   score pips, out of the ball's reach.
//
// Drawing never repaints a whole sprite after the first stamp. A move only
// writes the new edge and clears the old one. put_row() and fill_rows() take
// only the raster y (in A); column, pixel value and span length live in
// globals, so a stamp and the matching erase share the same draw_h.
//
// What to look at in the listing: put_row() and read_row() are @inline, so
// they cost what a macro would: fill_rows() has put_row()'s body in its loop
// (`; inline put_row`), with y in C and n in B, and no CALL, RET or save.
// Neither has an out-of-line copy. The private functions play() calls once
// (setup, wait_frame, serve, move_ai, physics, restore) are expanded there
// automatically (`; inline ... (auto)`), so they have no copy either; their
// directives below run against a build that keeps the bodies.
// play() never returns in a test run, so it is skipped.
//
// Keyboard is an 11x8 active-low matrix: out 03H selects the row, in 58H
// reads the columns (0 = pressed). Joystick / cursor keys are row 8
// (bit 1 up, bit 2 down). Space is row 7 bit 5.

pub const u8 WIN = 5;

// state
const u8 ST_SERVE = 0;  // ball centred, waiting for Space
const u8 ST_PLAY = 1;
const u8 ST_WON = 2;    // player reached WIN
const u8 ST_LOST = 3;   // AI reached WIN

// Geometry: columns are VRAM bytes, Y is rasters.
const u16 VRAM = 0x8000;
const u8 ROWS = 240;
const u8 PAD_H = 24;
const u8 BALL_H = 4;
const u8 COL_P = 2;         // player paddle
const u8 COL_AI = 61;       // AI paddle
const u8 COL_P_PIPS = 0;    // player score
const u8 COL_AI_PIPS = 63;  // AI score
const u8 PIP_H = 4;         // pip n (1..WIN) is rows [n * 8, n * 8 + PIP_H)
const u8 P_STEP = 2;        // rasters per frame; the AI moves one
const u8 PAD_Y0 = (ROWS - PAD_H) >> 1;
const u8 BALL_X0 = 32;
const u8 BALL_Y0 = (ROWS - BALL_H) >> 1;
const u8 INK = 0xFF;        // four white pixels
const u8 PAPER = 0;

// I/O
const u8 PORT_MAP = 0x02;
const u8 PORT_KROW = 0x03;
const u8 PORT_KCOL = 0x58;
const u8 ROW_JOY = 8;
const u8 JOY_UP = 0x02;
const u8 JOY_DOWN = 0x04;
const u8 ROW_SPACE = 7;
const u8 KEY_SPACE = 0x20;
const u8 MAP_GAME = 0x50;   // U0 U1 VID SYS: VID0 in the 8000H window
const u8 MAP_BASIC = 0x70;  // U0 U1 U2 SYS

u8 state;
u8 pscore;
u8 ascore;
u8 py;          // left paddle top, even, steps of P_STEP
u8 ay;          // right paddle top, steps of 1
u8 bx;          // ball column COL_P + 1 .. COL_AI - 1
u8 by;          // ball top raster
i8 vx;          // 0 = waiting to serve, else ±1
i8 vy;
u8 draw_col;    // VRAM column for put_row
u8 draw_val;    // INK or PAPER
u8 draw_h;      // how many rasters fill_rows should write

// OUT (3),A then IN A,(58H): row arrives in A, the columns return in A.
//! expect: read_row(8) == 0x7F with in(0x58) = 0x7F
//! expect-mem: read_row(8) => out(0x03) == 8
@inline u8 read_row(u8 row) {
    cpu::out(PORT_KROW, row);
    return cpu::in(PORT_KCOL);
}

// Store draw_val at (draw_col, y). y * 64 is `<< 6` of the zero-extended y
// in HL (C80 has no `*`). The compiler shifts right by two and moves bytes
// instead of doubling six times:
//
//     XOR A
//     SRL H / RR L / RRA    ; twice: the low bits leave through carry into A
//     LD H,L
//     LD L,A                ; 52 T, 13 bytes
//
// Six `a += a` lines compiled to LD D,H / LD E,L / ADD HL,DE each (114 T,
// 18 bytes); the whole function went from 228 T, 43 bytes to the budgets
// below. They measure the body as a function; expanded in fill_rows() it
// also saves the CALL and RET (27 T per row).
//! expect-tstates: put_row == 151
//! expect-bytes: put_row == 34
//! expect-mem: put_row(3) => [0x80C2] == 0xFF with draw_col = 2, draw_val = 0xFF
//! expect-mem: put_row(239) => [0xBBFD] == 0xFF with draw_col = 61, draw_val = 0xFF
@inline void put_row(u8 y) {
    u16 a;
    ptr<u8> p;
    a = u16(y) << 6;
    p = ptr<u8>(a + VRAM) + draw_col;
    *p = draw_val;
}

// Write draw_h rasters starting at y. Count down a copy, so a later erase
// can still see the original draw_h.
//! expect-mem: fill_rows(10) => [0x8282] == 0xFF with draw_h = 2, draw_col = 2, draw_val = 0xFF
//! expect-mem: fill_rows(10) => [0x82C2] == 0xFF with draw_h = 2, draw_col = 2, draw_val = 0xFF
//! expect-mem: fill_rows(10) => [0x8302] == 0 with draw_h = 2, draw_col = 2, draw_val = 0xFF
//! expect-mem: fill_rows(10) => draw_h == 2 with draw_h = 2, draw_col = 2, draw_val = 0xFF
void fill_rows(u8 y) {
    u8 n;
    n = draw_h;
    while (n != 0) {
        put_row(y);
        y = y + 1;
        n = n - 1;
    }
}

// Sleep until the frame interrupt. play() runs with interrupts disabled;
// this is the only place they are enabled. irq.asm's handler acknowledges
// (OUT 07H) and returns without EI, so the game logic runs with them off
// again. The request is latched, so a frame that ends while the logic is
// still running is not lost: the HALT wakes at once. EI delays acceptance
// by one instruction, so the request cannot slip in between EI and HALT.
// The handler touches no register or flag, so the block clobbers nothing.
//! expect-skip: wait_frame - HALT needs the frame interrupt
void wait_frame() {
    asm () {
        ei
        halt
    }
}

// Center the ball and freeze it. Space in serve() sets vx/vy.
//! expect-mem: place_ball() => bx == 32
//! expect-mem: place_ball() => by == 118
void place_ball() {
    bx = BALL_X0;
    by = BALL_Y0;
    vx = 0;
    vy = 0;
    state = ST_SERVE;
}

// Paddle [pad_y, pad_y+24) overlaps ball [by, by+4). pad_y arrives in A;
// by is read from its global.
//! expect: hits(100) == true with by = 110
//! expect: hits(100) == false with by = 124
//! expect: hits(100) == false with by = 96
//! expect: hits(100) == true with by = 97
bool hits(u8 pad_y) {
    if (by < pad_y + PAD_H && pad_y < by + BALL_H) {
        return true;
    }
    return false;
}

// Count the point, add its pip (pip n at raster n * 8), and either end the
// game or re-centre the ball.
//! expect-mem: scored(true) => state == 2 with pscore = 4
//! expect-mem: scored(false) => ascore == 1
//! expect-mem: scored(false) => bx == 32 with bx = 5
//! expect-mem: scored(true) => [0x8400] == 0xFF with pscore = 1
//! expect-mem: scored(false) => [0x823F] == 0xFF
void scored(bool player) {
    u8 score;
    draw_h = PIP_H;
    draw_val = INK;
    if (player) {
        pscore = pscore + 1;
        score = pscore;
        draw_col = COL_P_PIPS;
    } else {
        ascore = ascore + 1;
        score = ascore;
        draw_col = COL_AI_PIPS;
    }
    fill_rows(score << 3);
    if (score == WIN) {
        if (player) {
            state = ST_WON;
        } else {
            state = ST_LOST;
        }
        return;
    }
    place_ball();
}

// Joystick up (bit 1 low) moves the paddle up two rasters.
//! expect-mem: move_player() => py == 8 with py = 10, in(0x58) = 0xFD
//! expect-mem: move_player() => py == 12 with py = 10, in(0x58) = 0xFB
void move_player() {
    u8 joy;
    joy = read_row(ROW_JOY);
    // Up: new top is two white rows at py; old bottom was [py+24, py+26).
    if ((joy & JOY_UP) == 0) {
        if (py >= P_STEP) {
            py = py - P_STEP;
            draw_col = COL_P;
            draw_h = P_STEP;
            draw_val = INK;
            fill_rows(py);
            draw_val = PAPER;
            fill_rows(py + PAD_H);
        }
    }
    // Down: erase the old top at py-2, stamp two new rows at py+22
    // (the paddle now ends at py+24).
    if ((joy & JOY_DOWN) == 0) {
        if (py < ROWS - PAD_H - P_STEP) {
            py = py + P_STEP;
            draw_col = COL_P;
            draw_h = P_STEP;
            draw_val = PAPER;
            fill_rows(py - P_STEP);
            draw_val = INK;
            fill_rows(py + (PAD_H - P_STEP));
        }
    }
}

// Space (row 7, bit 5 low) serves.
//! expect-mem: serve() => state == 1 with in(0x58) = 0xDF
//! expect-mem: serve() => state == 0 with in(0x58) = 0xFF
void serve() {
    u8 keys;
    keys = read_row(ROW_SPACE);
    if (vx == 0 && (keys & KEY_SPACE) == 0) {
        vx = 1;
        vy = 1;
        state = ST_PLAY;
    }
}

// One raster per frame, and only while the ball is moving, so the player
// (step 2) can outrun it. Compare centres: ball is 4 tall, paddle 24.
//! expect-mem: move_ai() => ay == 51 with vx = 1, by = 118, ay = 50
//! expect-mem: move_ai() => ay == 50 with vx = 0, by = 118, ay = 50
void move_ai() {
    u8 ball;
    u8 pad;
    if (vx == 0) {
        return;
    }
    ball = by + (BALL_H >> 1);
    pad = ay + (PAD_H >> 1);
    if (ball < pad) {
        if (ay != 0) {
            ay = ay - 1;
            draw_col = COL_AI;
            draw_h = 1;
            draw_val = INK;
            fill_rows(ay);
            draw_val = PAPER;
            fill_rows(ay + PAD_H);
        }
    } else {
        if (ball > pad) {
            if (ay < ROWS - PAD_H) {
                ay = ay + 1;
                draw_col = COL_AI;
                draw_h = 1;
                draw_val = PAPER;
                fill_rows(ay - 1);
                draw_val = INK;
                fill_rows(ay + (PAD_H - 1));
            }
        }
    }
}

// After physics(), (ox, oy) is where the ball was. Same column: slide
// vertically (paint the uncovered edge, clear the vacated one). Column
// changed: erase the old 4-row stamp and draw a new one — even if Y moved
// too. A paddle bounce keeps X still, so it takes the Y-only path.
// Moving down from raster 19 to 20 in column 10 clears row 19 and paints 23.
//! expect-mem: ball_sync(10, 19) => [0x84CA] == 0 with bx = 10, by = 20, [0x84CA] = 0xFF
//! expect-mem: ball_sync(10, 19) => [0x85CA] == 0xFF with bx = 10, by = 20
void ball_sync(u8 ox, u8 oy) {
    if (bx == ox) {
        if (by == oy) {
            return;
        }
        draw_col = bx;
        if (by < oy) {
            draw_h = oy - by;
            draw_val = INK;
            fill_rows(by);
            draw_val = PAPER;
            fill_rows(by + BALL_H);
        } else {
            draw_h = by - oy;
            draw_val = PAPER;
            fill_rows(oy);
            draw_val = INK;
            fill_rows(oy + BALL_H);
        }
        return;
    }
    draw_h = BALL_H;
    draw_col = ox;
    draw_val = PAPER;
    fill_rows(oy);
    draw_col = bx;
    draw_val = INK;
    fill_rows(by);
}

//! expect-mem: physics() => bx == 11 with vx = 1, vy = 1, bx = 10, by = 20
//! expect-mem: physics() => by == 21 with vx = 1, vy = 1, bx = 10, by = 20
//! expect-mem: physics() => vy == 1 with vx = 1, vy = -1, bx = 10, by = 0
//! expect-mem: physics() => vx == -1 with vx = 1, vy = 1, bx = 60, by = 100, ay = 90
//! expect-mem: physics() => ascore == 0 with vx = 1, vy = 1, bx = 60, by = 100, ay = 90
//! expect-mem: physics() => pscore == 1 with vx = 1, vy = 1, bx = 60, by = 100, ay = 0
//! expect-mem: physics() => ascore == 1 with vx = -1, vy = 1, bx = 3, by = 100, py = 0
void physics() {
    u8 ox;
    u8 oy;
    if (vx == 0) {
        return;
    }
    ox = bx;
    oy = by;
    // Ball is 4 rasters; 236+4 = 240, the first row past the paper.
    if (vy < 0) {
        if (by == 0) {
            vy = 1;
        } else {
            by = by - 1;
        }
    } else {
        if (by >= ROWS - BALL_H) {
            vy = -1;
        } else {
            by = by + 1;
        }
    }
    // On the column next to a paddle: bounce (flip vx, keep X so ball_sync
    // takes the same-column path) or score. The ball never enters a paddle
    // column, so its erase cannot cut into a paddle.
    if (vx < 0) {
        if (bx != COL_P + 1) {
            bx = bx - 1;
        } else {
            if (hits(py)) {
                vx = 1;
            } else {
                scored(false);
            }
        }
    } else {
        if (bx != COL_AI - 1) {
            bx = bx + 1;
        } else {
            if (hits(ay)) {
                vx = -1;
            } else {
                scored(true);
            }
        }
    }
    ball_sync(ox, oy);
}

//! expect-mem: setup() => out(0x02) == 0x50
//! expect-mem: setup() => [0x0B13] == 0x11 with [0x0B13] = 0x12
//! expect-mem: setup() => [0xBBFF] == 0 with [0xBBFF] = 0x55
void setup() {
    ptr<u8> pal;
    ptr<u8> vram;
    // Palette 0..3 and a dark border. 0x0B13 is the firmware copy of port
    // 06H; force bits 0-1 to 01 (GRAPHICS 4) and write it back.
    cpu::out(0x60, 0);
    cpu::out(0x61, 0x14);
    cpu::out(0x62, 0x44);
    cpu::out(0x63, 0x55);
    cpu::out(0x00, 0x20);
    pal = ptr<u8>(0x0B13);
    *pal = (*pal & 0xFC) | 0x01;
    cpu::out(0x06, *pal);
    // VID0 in the 8000H window. restore() puts U2 back there.
    cpu::out(PORT_MAP, MAP_GAME);
    // R10/R11: cursor shape. R14-R15 = 0x0EFF, last paper byte, so the
    // cursor IRQ (and wait_frame) lands on raster 239. VT-DOS leaves
    // 0x0AFF (raster 175) and would sync mid-screen.
    cpu::out(0x70, 0x0A);
    cpu::out(0x71, 0x03);
    cpu::out(0x70, 0x0B);
    cpu::out(0x71, 0x03);
    cpu::out(0x70, 0x0E);
    cpu::out(0x71, 0x0E);
    cpu::out(0x70, 0x0F);
    cpu::out(0x71, 0xFF);
    // 240 * 64 = 0x3C00 paper bytes. Zero the first, LDIR the rest
    // (HL is source, DE is dest — Z80 order, not memcpy).
    vram = ptr<u8>(VRAM);
    *vram = PAPER;
    cpu::ldir(vram, ptr<u8>(VRAM + 1), 0x3BFF);
}

// BASIC continues in GRAPHICS 4 with the game's palette and screen; the
// firmware copy at 0x0B13 agrees. irq.asm restores the vector and EIs.
//! expect-mem: restore() => out(0x02) == 0x70
void restore() {
    cpu::out(PORT_MAP, MAP_BASIC);
}

// Called from irq.asm with interrupts disabled and the frame vector hooked.
// The USR argument arrives in HL and is ignored. Return 1 or -1 in HL.
// @fastcall: the loop fits in registers (no spill, save or IX).
//! expect-skip: play - loops until someone reaches WIN; needs keyboard input over many frames
@fastcall pub i16 play(i16 unused) {
    setup();
    pscore = 0;
    ascore = 0;
    py = PAD_Y0;
    ay = PAD_Y0;
    place_ball();
    draw_val = INK;
    draw_h = PAD_H;
    draw_col = COL_P;
    fill_rows(py);
    draw_col = COL_AI;
    fill_rows(ay);
    draw_h = BALL_H;
    draw_col = bx;
    fill_rows(by);
    while (state < ST_WON) {
        wait_frame();
        move_player();
        serve();
        move_ai();
        physics();
    }
    restore();
    if (state == ST_WON) {
        return 1;
    }
    return -1;
}
