// Inline asm is a statement. The body is helper-assembler text, not C80.
// Header operands are evaluated once, left to right, before the body.
// RET, ORG and jumping out of the block are rejected (inline_asm.fail.c80).

// `in: a = value` loads A before the body; `out: a = result` reads A after.
//! expect: inc8(41) == 42
//! expect: inc8(255) == 0
u8 inc8(u8 value) {
    u8 result;
    asm (in: a = value, out: a = result, clobber: flags) {
        inc a
    }
    return result;
}

// `out: carry = carry` captures the carry flag as a bool.
// 200 + 100 = 300: the byte is 44 with carry set, so 45.
//! expect: add_carry(200, 100) == 45
//! expect: add_carry(1, 2) == 3
//! expect: add_carry(255, 1) == 1
u8 add_carry(u8 left, u8 right) {
    u8 sum;
    bool carry;
    asm (in: a = left, in: b = right, out: a = sum, out: carry = carry, clobber: flags) {
        add a, b
    }
    if (carry) {
        return sum + 1;
    }
    return sum;
}
